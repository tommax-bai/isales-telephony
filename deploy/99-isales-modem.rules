# udev rules for isales modem-controller — assigns stable device names
# and group ownership so the modem-controller process can read/write
# without root.
#
# Spec: device-hardware § udev 自动检测流程
# Install: sudo cp 99-isales-modem.rules /etc/udev/rules.d/
#          sudo udevadm control --reload && sudo udevadm trigger

# Simcom A7670 — primary v1 target.
SUBSYSTEM=="tty", ATTRS{idVendor}=="1e0e", ATTRS{idProduct}=="9001", \
    SYMLINK+="ttyUSB-isales-modem", GROUP="dialout", MODE="0660"

# SIMCom 800-series.
SUBSYSTEM=="tty", ATTRS{idVendor}=="1e0e", ATTRS{idProduct}=="9011", \
    SYMLINK+="ttyUSB-isales-modem", GROUP="dialout", MODE="0660"

# Quectel UC20 / EC25.
SUBSYSTEM=="tty", ATTRS{idVendor}=="2c7c", ATTRS{idProduct}=="0125", \
    SYMLINK+="ttyUSB-isales-modem", GROUP="dialout", MODE="0660"

# Generic Qualcomm-based USB GSM modem.
SUBSYSTEM=="tty", ATTRS{idVendor}=="05c6", ATTRS{idProduct}=="9000", \
    SYMLINK+="ttyUSB-isales-modem", GROUP="dialout", MODE="0660"

# Sound side: ALSA card belonging to the same modem gets a stable id.
SUBSYSTEM=="sound", ATTRS{idVendor}=="1e0e", \
    SYMLINK+="snd/by-id/usb-isales-modem", GROUP="audio", MODE="0660"
SUBSYSTEM=="sound", ATTRS{idVendor}=="2c7c", \
    SYMLINK+="snd/by-id/usb-isales-modem", GROUP="audio", MODE="0660"
